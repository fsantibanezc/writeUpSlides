{
  "manifest_version": 3,
  "name": "Slides Free Draw",
  "version": "1.7",
  "description": "Draw over Google Slides while presenting",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://docs.google.com/presentation/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
